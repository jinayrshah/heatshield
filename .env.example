# Copy to .env (never commit .env) and fill in what you use. All are optional.

# Database. SQLite file by default; use Postgres in production, for example
# postgresql+psycopg://user:pass@host/heatshield
DATABASE_URL=sqlite:///./heatshield.db

# 1 = use the recorded Mumbai forecast instead of live Open-Meteo (offline demos).
HEATSHIELD_SAMPLE_DATA=0
# 0 = do not run the alert job inside the web process.
HEATSHIELD_SCHEDULER=1
HEATSHIELD_CACHE_TTL_S=3600
# A night whose coolest hour stays at or above this (°C) triggers a warm-night alert.
HEATSHIELD_WARM_NIGHT_C=28

# Telegram (from @BotFather). The username enables the "Connect Telegram" button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Your own chat id: you get a message if the alert job fails.
OPERATOR_TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta). The template must be approved and take one body parameter.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
